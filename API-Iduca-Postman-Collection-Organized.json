								"method": "GET",
								"url": {
									"raw": "{{base_url}}/api/users/all?Page=1&MaxItems=10",
									"host": ["{{base_url}}"],
									"path": ["api", "users", "all"],
									"query": [
										{
											"key": "Page",
											"value": "1"
										},
										{
											"key": "MaxItems",
											"value": "10"
										}
									]
								},
								"description": "Listar todos os usuários com paginação (apenas admins)"
							}
