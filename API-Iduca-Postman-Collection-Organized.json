							}
						},
						{
							"name": "Listar Usuários com Filtros",
							"request": {
								"method": "GET",
								"url": {
									"raw": "{{base_url}}/api/users/all?Name=João&IsAdmin=false&Page=1&MaxItems=5",
									"host": ["{{base_url}}"],
									"path": ["api", "users", "all"],
