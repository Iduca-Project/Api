	"item": [
		{
			"name": "🔐 Auth Controller",
			"description": "Rotas de autenticação (públicas)",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.environment.set('auth_token', response.token);",
									"    pm.collectionVariables.set('auth_token', response.token);",
									"    console.log('Token salvo:', response.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"joao.santos.atualizado@teste.com\",\n  \"password\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Fazer login de usuário. O token retornado será automaticamente salvo para usar nas outras requisições."
					}
				},
				{
					"name": "Login - Admin",
					"event": [
						{
							"listen": "test",
