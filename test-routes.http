@baseUrl = http://localhost:5284

# =====================================
# TESTES DE USERS
# =====================================

### Criar uma empresa primeiro (necessário para criar usuário)
POST {{baseUrl}}/api/company
Content-Type: application/json

{
  "name": "Empresa Teste",
  "cnpj": "12345678000199",
  "email": "contato@empresateste.com",
  "phone": "(11) 99999-9999"
}

### Criar uma categoria (necessário para os interesses do usuário)
POST {{baseUrl}}/api/categories
Content-Type: application/json

{
  "name": "Tecnologia",
  "description": "Categoria sobre tecnologia"
}

### Criar outra categoria
POST {{baseUrl}}/api/categories
Content-Type: application/json

{
  "name": "Programação",
  "description": "Categoria sobre programação"
}

### Listar todas as categorias
GET {{baseUrl}}/api/categories/all
Accept: application/json

### Buscar categoria por ID (substitua pelo ID real)
GET {{baseUrl}}/api/categories/00000000-0000-0000-0000-000000000000
Accept: application/json

### Buscar categoria por nome
GET {{baseUrl}}/api/categories/search?Name=Tecnologia
Accept: application/json

### Criar um usuário
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "João Silva",
  "identity": "12345678901",
  "email": "joao.silva@teste.com",
  "password": "123456",
  "isAdmin": false,
  "responsibleId": null,
  "companyId": "00000000-0000-0000-0000-000000000000",
  "image": "https://example.com/avatar.jpg",
  "interests": []
}

### Criar um usuário administrador
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "Maria Santos",
  "identity": "98765432100",
  "email": "maria.santos@teste.com",
  "password": "admin123",
  "isAdmin": true,
  "responsibleId": null,
  "companyId": "00000000-0000-0000-0000-000000000000",
  "image": null,
  "interests": []
}

### Listar todos os usuários (com paginação)
GET {{baseUrl}}/api/users/all?Page=1&MaxItems=10
Accept: application/json

### Buscar usuários por nome
GET {{baseUrl}}/api/users/all?Name=João&Page=1&MaxItems=10
Accept: application/json

### Buscar usuários por email
GET {{baseUrl}}/api/users/all?Email=joao&Page=1&MaxItems=10
Accept: application/json

### Buscar apenas administradores
GET {{baseUrl}}/api/users/all?IsAdmin=true&Page=1&MaxItems=10
Accept: application/json

### Buscar usuário por ID (substitua pelo ID real)
GET {{baseUrl}}/api/users/00000000-0000-0000-0000-000000000000
Accept: application/json

### Atualizar usuário (substitua pelo ID real)
PUT {{baseUrl}}/api/users
Content-Type: application/json

{
  "id": "00000000-0000-0000-0000-000000000000",
  "name": "João Silva Santos",
  "identity": "12345678901",
  "email": "joao.santos@teste.com",
  "isAdmin": false,
  "responsibleId": null,
  "companyId": "00000000-0000-0000-0000-000000000000",
  "image": "https://example.com/new-avatar.jpg",
  "interests": []
}

### Deletar usuário (substitua pelo ID real)
DELETE {{baseUrl}}/api/users/00000000-0000-0000-0000-000000000000

# =====================================
# TESTES DE COURSES
# =====================================

### Criar um curso
POST {{baseUrl}}/api/course
Content-Type: application/json

{
  "name": "Curso de .NET Core",
  "description": "Aprenda desenvolvimento com .NET Core",
  "difficulty": 2,
  "image": "https://example.com/course.jpg",
  "totalHours": 40,
  "categories": []
}

### Listar cursos
GET {{baseUrl}}/api/course/all?Page=1&MaxItens=10
Accept: application/json

### Buscar curso por ID (substitua pelo ID real)
GET {{baseUrl}}/api/course/00000000-0000-0000-0000-000000000000
Accept: application/json

### Atualizar curso (substitua pelo ID real)
PATCH {{baseUrl}}/api/course
Content-Type: application/json

{
  "id": "00000000-0000-0000-0000-000000000000",
  "name": "Curso Avançado de .NET Core",
  "description": "Aprenda desenvolvimento avançado com .NET Core",
  "difficulty": 3,
  "image": "https://example.com/advanced-course.jpg",
  "totalHours": 60,
  "categories": []
}

### Deletar curso (substitua pelo ID real)
DELETE {{baseUrl}}/api/course/00000000-0000-0000-0000-000000000000

# =====================================
# TESTES DE MODULES
# =====================================

### Criar um módulo
POST {{baseUrl}}/api/modules
Content-Type: application/json

{
  "name": "Introdução ao .NET",
  "description": "Módulo introdutório sobre .NET Core",
  "index": 1,
  "courseId": "00000000-0000-0000-0000-000000000000"
}

### Buscar módulos por curso (substitua pelo ID real)
GET {{baseUrl}}/api/modules/course/00000000-0000-0000-0000-000000000000
Accept: application/json

### Buscar módulo por ID (substitua pelo ID real)
GET {{baseUrl}}/api/modules/00000000-0000-0000-0000-000000000000
Accept: application/json

### Atualizar módulo
PUT {{baseUrl}}/api/modules
Content-Type: application/json

{
  "id": "00000000-0000-0000-0000-000000000000",
  "name": "Introdução Avançada ao .NET",
  "description": "Módulo introdutório avançado sobre .NET Core",
  "index": 1,
  "courseId": "00000000-0000-0000-0000-000000000000"
}

### Deletar módulo (substitua pelo ID real)
DELETE {{baseUrl}}/api/modules/00000000-0000-0000-0000-000000000000
